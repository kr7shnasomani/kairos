# =============================================================================
# Kairos — Environment Variables
# Copy this to .env and fill in the blanks for cloud services.
# Local Docker service defaults are pre-filled.
# =============================================================================

# --- App ---
APP_ENV=development                 # set to "production" on the hosted box (enables secret guardrail + rate limit)
APP_DEBUG=true                      # MUST be false in production
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# --- Public-API abuse guards ---
MAX_UPLOAD_MB=25                    # reject document uploads larger than this
RATE_LIMIT_PER_MINUTE=120           # per-IP cap; enforced only when APP_ENV=production (0 = off)
INTERNAL_API_KEY=kairos-internal-dev-key   # service-to-service key (Go connector, workers, loader) — CHANGE outside dev; production refuses to boot on this default
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]   # JSON list of allowed browser origins
AUTH_CACHE_TTL_SECONDS=60           # token-verification cache; bounds revocation staleness (0 = verify every request)
# MOC_WEBHOOK_SECRET=               # set to require a valid X-Webhook-Signature on MoC webhooks (unset = unsigned accepted)
KAIROS_PHASE=3                      # 1-3 phased rollout; proactive brief push is Phase 3
MODEL_GATE_ENFORCE=false            # report-only: a failed model gate does not halt extraction
TIMESTAMP_DRIFT_ENFORCE=false       # report-only: cross-system timestamp drift is logged, not quarantined

# =============================================================================
# STORAGE — Supabase (Cloud)
# =============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=kairos-vault

# =============================================================================
# GRAPH — Neo4j (Aura cloud in the reference setup; bolt://localhost with --profile local-stores)
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=kairos_dev_password
NEO4J_DATABASE=neo4j
# Password for the `--profile local-stores` container only (its admin user is always
# `neo4j` — Neo4j rejects any other initial admin name). Kept separate so pointing
# NEO4J_* at Aura never stops the local container from booting.
NEO4J_LOCAL_PASSWORD=kairos_dev_password

# =============================================================================
# VECTOR STORE — Qdrant (Qdrant Cloud in the reference setup; localhost with --profile local-stores)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_KNOWLEDGE=kairos_knowledge
QDRANT_COLLECTION_DOCUMENTS=kairos_documents

# =============================================================================
# SEARCH — Elasticsearch (Local Docker)
# =============================================================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_ASSETS=kairos_assets
ELASTICSEARCH_INDEX_DOCUMENTS=kairos_documents
ELASTICSEARCH_INDEX_EVENTS=kairos_events

# =============================================================================
# CACHE + EVENT BUS — Redis (Local Docker)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1
REDIS_DB_STREAMS=2
REDIS_STREAM_WORK_ORDERS=kairos:events:work_orders
REDIS_STREAM_PTW=kairos:events:ptw
REDIS_STREAM_SHIFT_HANDOVER=kairos:events:shift_handover
REDIS_STREAM_ALARMS=kairos:events:alarms
REDIS_STREAM_BRIEFS=kairos:events:briefs
REDIS_STREAM_TAG_OUT=kairos:events:tag_out
REDIS_STREAM_INSPECTIONS=kairos:events:inspections

# =============================================================================
# AI — NVIDIA NIM (Cloud — used for LLM synthesis only)
# =============================================================================
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_MAX_TOKENS=4096
NVIDIA_NIM_TEMPERATURE=0.1
NVIDIA_NIM_TIMEOUT=60                # must stay under the frontend's 90 s synthesize budget
NVIDIA_NIM_NER_TIMEOUT=120           # background ingestion NER — no UI budget, the hosted model is slow
NVIDIA_NIM_DISABLE_THINKING=true     # Nemotron 3: answer directly instead of hidden reasoning
# Vision model for P&ID topology extraction (Layer 3, Path B)
NVIDIA_NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# NER extraction. Was mistralai/ministral-14b-instruct-2512, which NVIDIA deprecated — the
# endpoint now hangs until timeout, and NERService silently degrades to its regex fallback
# (ASSET_TAG only, no PERSON/ORGANIZATION). Verify a replacement responds before switching:
#   POST https://integrate.api.nvidia.com/v1/chat/completions with {"model": "<name>", ...}
NVIDIA_NIM_NER_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_OCR_MODEL=nvidia/nemotron-ocr-v2

# OpenRouter — synthesis tier 2 (before Gemini). Serves llama-3.1-70b, a different model from
# tier 1, so the benchmark counts an OpenRouter answer as a fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_TIMEOUT=60

# Gemini — optional LLM fallback (OpenAI-compatible endpoint; leave key blank to stay on NIM only).
# Fill GEMINI_API_KEY to enable the NIM → Gemini → Ollama cascade.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash-lite

# =============================================================================
# AI — Jina AI (Cloud — embeddings, keeps NIM free for synthesis)
# =============================================================================
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_EMBED_URL=https://api.jina.ai/v1/embeddings

# =============================================================================
# AI — Embeddings
# =============================================================================
EMBEDDING_DIMENSION=1024

# =============================================================================
# AI — Groq (Cloud — Whisper transcription via whisper-large-v3)
# =============================================================================
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# =============================================================================
# AI — Ollama (Local — fallback for offline / air-gapped deployments)
# Note: inside Docker containers use http://host.docker.internal:11434
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NER_MODEL=llama3.1:8b

# =============================================================================
# ASYNC TASKS — Celery
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_CONCURRENCY=4

# =============================================================================
# DURABLE WORKFLOWS — Temporal.io (Local Docker)
# =============================================================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=kairos-ingestion
TEMPORAL_TASK_QUEUE_ELICITATION=kairos-elicitation

# =============================================================================
# GOVERNANCE — Open Policy Agent (Local Docker)
# =============================================================================
# Compose service name, NOT localhost: inside the API container localhost is the API itself,
# so every authz call missed OPA and fail-open turned that into "allow". env_file is injected
# at container creation — after changing this, --force-recreate (a reload will not pick it up).
OPA_URL=http://kairos-opa:8181
OPA_POLICY_PATH=/policies/kairos.rego

# =============================================================================
# Temporal internal Postgres (container-to-container only; never published)
# Defaults are fine for local + AWS single-host. Override for hardened prod.
# Note: secrets/signing use cloud Supabase (Vault + DB) — no local Vault container.
# =============================================================================
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal

# =============================================================================
# OBSERVABILITY — OpenTelemetry + Grafana (Local Docker)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=kairos-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_HEADERS=            # Grafana Cloud: Authorization=Basic <base64 instance:token>
GRAFANA_ADMIN_PASSWORD=kairos_dev_password

# =============================================================================
# OT FEDERATION — Historian Connectors (Go service)
# =============================================================================
GO_CONNECTOR_PORT=8090
PI_WEBAPI_BASE_URL=
PI_WEBAPI_USERNAME=
PI_WEBAPI_PASSWORD=
OPCUA_ENDPOINT_URL=
HISTORIAN_QUERY_TIMEOUT_SECONDS=30

# =============================================================================
# EEMUA 191 — Push Governor
# =============================================================================
MAX_PUSH_PER_USER_PER_HOUR=6
BRIEF_COOLDOWN_HOURS=4
DEDUP_WINDOW_MINUTES=10
LATE_ARRIVAL_WINDOW_MINUTES=5
PLANT_STATE_DEFAULT=normal

# =============================================================================
# Ingestion pipeline
# =============================================================================
TIMESTAMP_DRIFT_TOLERANCE_MINUTES=60
