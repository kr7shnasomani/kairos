{
  "title": "Kairos — Operational Intelligence",
  "uid": "kairos-operational",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Briefs Delivered / Hour",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "grafana-prom-datasource" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"blue","value":null}] } }
      },
      "targets": [
        {
          "expr": "increase(kairos_briefs_delivered_total[1h])",
          "legendFormat": "Briefs/hr"
        }
      ]
    },
    {
      "id": 2,
      "title": "Governor Suppression / Hour",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "grafana-prom-datasource" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"orange","value":3},{"color":"red","value":6}] }
        }
      },
      "targets": [
        {
          "expr": "increase(kairos_governor_suppressed_total[1h])",
          "legendFormat": "Suppressed/hr"
        }
      ]
    },
    {
      "id": 3,
      "title": "Open Conflicts",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "grafana-prom-datasource" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"orange","value":1},{"color":"red","value":5}] }
        }
      },
      "targets": [
        {
          "expr": "kairos_conflicts_open",
          "legendFormat": "Open conflicts"
        }
      ]
    },
    {
      "id": 4,
      "title": "Governor Suppression Rate",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "grafana-prom-datasource" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "targets": [
        {
          "expr": "rate(kairos_governor_suppressed_total[5m]) / (rate(kairos_briefs_delivered_total[5m]) + rate(kairos_governor_suppressed_total[5m]) + 0.0001)",
          "legendFormat": "Suppression rate"
        }
      ]
    },
    {
      "id": 5,
      "title": "Briefs Delivered Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafana-prom-datasource" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "rate(kairos_briefs_delivered_total[5m]) * 60",
          "legendFormat": "{{priority}} / {{trigger_event_type}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Briefs by Priority",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafana-prom-datasource" },
      "options": { "pieType": "donut", "legendDisplayMode": "table", "legendPlacement": "right" },
      "targets": [
        {
          "expr": "increase(kairos_briefs_delivered_total[1h])",
          "legendFormat": "{{priority}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Open Conflicts by Track",
      "type": "bargauge",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafana-prom-datasource" },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"red","value":1}] } }
      },
      "targets": [
        {
          "expr": "kairos_conflicts_open",
          "legendFormat": "{{track}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Governor State by User",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafana-prom-datasource" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "increase(kairos_governor_suppressed_total[5m])",
          "legendFormat": "{{user_id}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Traces Explorer",
      "type": "traces",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"kairos-api\" } | select(span.http.route, span.http.status_code) | limit 20"
        }
      ]
    }
  ]
}
