# Kairos — HTTPS for the backend API (deployment only). Auto-TLS via Let's Encrypt.
# The frontend is hosted on Vercel and calls https://DOMAIN directly, so the API allows the
# Vercel origin through CORS_ORIGINS. Requires KAIROS_DOMAIN in .env, DNS A record → the EC2 IP,
# and ports 80 and 443 open. Used by the `kairos-caddy` service (profile prod). See docs/DEPLOY.md.
# No `encode` block: compression can buffer the Copilot answer stream (text/event-stream).
# Response headers and the body cap below do not buffer the stream: Caddy applies headers when the
# response starts, and request_body only limits what the client uploads.
{$KAIROS_DOMAIN} {
	# Cap uploads at the proxy so an oversized body is refused before it is spooled to disk.
	# MAX_UPLOAD_MB is 25; the extra headroom covers multipart framing.
	request_body {
		max_size 30MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy kairos-backend-api:8000
}
