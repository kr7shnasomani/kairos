# Supply-chain guards. Policy and the security-patch exception: README.md › Supply-Chain Security.
# Needs npm 11 (Node 24, which Docker, CI and Vercel all run) for min-release-age and strict-allow-scripts.

# Dependencies never run install scripts (the usual way a compromised package attacks).
ignore-scripts=true
# If a dependency ever needs one, fail the install loudly instead of warning.
strict-allow-scripts=true
# Only resolve versions published at least 7 days ago; hijacked releases are usually pulled within days.
min-release-age=7
# New dependencies are saved at an exact version, never a range.
save-exact=true
# Refuse to install on an unsupported Node version.
engine-strict=true
