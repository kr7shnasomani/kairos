# =============================================================================
# Kairos — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/
*.pyd

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.env.local
.env.production
.env.staging
# Keep .env.example (template), ignore actual .env
.env
!.env.example

# --- ML model cache ---
.cache/
*.onnx
*.pt
*.pth
*.bin
*.safetensors
/backend/.cache/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc
.tox/

# --- Type checking ---
.mypy_cache/
.dmypy.json
.pytype/

# --- Linting ---
.ruff_cache/

# --- Go ---
/backend/connectors/vendor/
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out

# --- Node / Next.js (frontend — future) ---
node_modules/
.next/
out/
.nuxt/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.pnp.*

# --- Database ---
# Local Neo4j data (managed by Docker volumes, not tracked)
/data/neo4j/
/data/qdrant/
/data/elasticsearch/
/data/redis/
/data/temporal/

# --- IDE / OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# --- Secrets / Keys ---
*.pem
*.key
*.p12
*.pfx
vault-data/
vault.json
# HashiCorp Vault dev data
/vault/data/

# --- Logs ---
*.log
logs/
/backend/logs/

# --- Uploads / Temp ---
/tmp/
/uploads/
*.tmp

# --- Grafana state ---
/backend/grafana/data/

# --- OpenTelemetry ---
# Config is tracked, data is not
/backend/otel/data/

# --- Temporal ---
/backend/temporal/data/

# --- Documentation builds ---
/docs/_build/
/docs/site/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- HuggingFace downloads ---
/backend/.cache/huggingface/

# Local .env backups
.env.bak.*

# Benchmark run logs + checkpoints
backend/.benchmark_runs/

# Supabase CLI link cache (project ref, pooler URL) — written by `supabase link`, machine-local
supabase/.temp/
